PORT=3000
JWT_SECRET=change-this-secret-before-production
JWT_EXPIRES_IN_SECONDS=3600

# Supported values: mock, gemini, codex, github_copilot
LLM_PROVIDER=mock

# Provider API keys/tokens. Keep only the one you use populated in real usage.
GEMINI_API_KEY=replace-with-gemini-api-key
CODEX_API_KEY=replace-with-codex-api-key
GITHUB_COPILOT_TOKEN=replace-with-github-copilot-token

# Optional model names.
GEMINI_MODEL=gemini-1.5-flash
CODEX_MODEL=gpt-4.1-mini
GITHUB_COPILOT_MODEL=gpt-4o-mini
